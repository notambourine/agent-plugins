  "font": {
    "$description": "Hanken Grotesk headings over a JetBrains Mono body, with Nunito reserved for the wordmark. The --nt-* primitive carries the stack and the alias names the job: Tailwind claims --font-*, so a Tailwind surface reads the primitive.",
    "$type": "fontFamily",
    "nt-font-nunito": {
      "$value": ["Nunito", "system-ui", "sans-serif"]
    },
    "nt-font-hanken": {
      "$value": ["Hanken Grotesk", "system-ui", "sans-serif"]
    },
    "nt-font-jetbrains": {
      "$value": [
        "JetBrains Mono",
        "ui-monospace",
        "SF Mono",
        "Monaco",
        "monospace"
      ]
    },
    "font-wordmark": {
      "$value": "{font.nt-font-nunito}",
      "$description": "the lockup, nothing else",
      "$extensions": {
        "com.notambourine.tailwind": "font-wordmark"
      }
    },
    "font-display": {
      "$value": "{font.nt-font-hanken}",
      "$description": "headings",
      "$extensions": {
        "com.notambourine.tailwind": "font-display"
      }
    },
    "font-accent": {
      "$value": "{font.nt-font-jetbrains}",
      "$description": "eyebrows, labels, buttons",
      "$extensions": {
        "com.notambourine.tailwind": "font-accent"
      }
    },
    "font-body": {
      "$value": "{font.nt-font-jetbrains}",
      "$description": "body",
      "$extensions": {
        "com.notambourine.tailwind": "font-body"
      }
    },
    "font-mono": {
      "$value": "{font.nt-font-jetbrains}",
      "$description": "code: same face",
      "$extensions": {
        "com.notambourine.tailwind": "font-mono"
      }
    }
  },
  "size": {
    "$description": "A 1.25 modular scale in rem, so a raised browser default scales the page. Comments give px at a 16px root.",
    "$type": "dimension",
    "fs-display": {
      "$value": {
        "value": 4,
        "unit": "rem"
      },
      "$description": "fluid: 40px floor holds \"tambourine.\" at 375px, 64px from 960px up",
      "$extensions": {
        "com.notambourine.css": "clamp(2.5rem, 1.75rem + 3.75vw, 4rem)",
        "com.notambourine.tailwind": "text-display"
      }
    },
    "fs-h1": {
      "$value": {
        "value": 2.75,
