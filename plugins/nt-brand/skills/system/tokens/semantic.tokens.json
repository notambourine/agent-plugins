      "$value": {
        "colorSpace": "srgb",
        "components": [0.9059, 0.3529, 0.4863],
        "alpha": 0.16,
        "hex": "#E75A7C"
      },
      "$description": "on dark: tinted pink, not pastel",
      "$extensions": {
        "com.notambourine.tailwind": "color-accent-soft"
      }
    },
    "accent-text": {
      "$value": "{brand.nt-pink}",
