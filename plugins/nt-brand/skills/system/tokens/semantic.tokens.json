      "$value": "{dark-surfaces.nt-fg-mute}",
      "$description": "placeholder, disabled",
      "$extensions": {
        "com.notambourine.tailwind": "color-fg-disabled"
      }
    },
    "fg-on-pink": {
      "$value": "{brand.nt-ink}",
